@article{kestenSchoolChoiceConsent2010,
  title = {School {{Choice}} with {{Consent}}*},
  author = {Kesten, Onur},
  date = {2010-08-01},
  journaltitle = {The Quarterly Journal of Economics},
  shortjournal = {Q J Econ},
