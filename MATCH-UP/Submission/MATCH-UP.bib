@article{eppleSchoolVouchersSurvey2017,
  title = {School {{Vouchers}}: {{A Survey}} of the {{Economics Literature}}},
  shorttitle = {School {{Vouchers}}},
  author = {Epple, Dennis and Romano, Richard E. and Urquiola, Miguel},
  date = {2017-06},
  journaltitle = {Journal of Economic Literature},
