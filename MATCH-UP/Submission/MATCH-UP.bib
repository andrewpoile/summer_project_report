@article{ehlersSchoolChoiceControlled2014,
  title = {School Choice with Controlled Choice Constraints: {{Hard}} Bounds versus Soft Bounds},
  shorttitle = {School Choice with Controlled Choice Constraints},
  author = {Ehlers, Lars and Hafalir, Isa E. and Yenmez, M. Bumin and Yildirim, Muhammed A.},
  date = {2014-09-01},
  journaltitle = {Journal of Economic Theory},
